#!/bin/sh
# Scripted scancel: terminate the job's process group so the budget kill has
# something real to kill.
STATE=/var/ccfa-slurm
job="$1"
pid_file="$STATE/$job.pid"

if [ -f "$pid_file" ]; then
    pid=$(cat "$pid_file")
    kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
fi
exit 0
