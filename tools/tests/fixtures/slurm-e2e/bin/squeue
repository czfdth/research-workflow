#!/bin/sh
# Scripted squeue: report RUNNING while the job process lives, nothing once it
# is gone — the same shape the poll loop reads from a real cluster.
STATE=/var/ccfa-slurm

job=""
while [ $# -gt 0 ]; do
    case "$1" in
        -j) job="$2"; shift 2 ;;
        *) shift ;;
    esac
done
[ -n "$job" ] || exit 0

pid_file="$STATE/$job.pid"
if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
    echo RUNNING
fi
exit 0
